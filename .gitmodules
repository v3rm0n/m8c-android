[submodule "app/jni/libusb/libusb"]
	path = app/jni/libusb/libusb
	url = https://github.com/libusb/libusb.git
[submodule "app/jni/SDL"]
	path = app/jni/SDL
	url = https://github.com/libsdl-org/SDL.git
	branch = release-3.4.x
[submodule "app/jni/m8c"]
	path = app/jni/m8c
	url = https://github.com/dwat3r/m8c.git
	branch = feature/mic-input
